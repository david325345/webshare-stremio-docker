# Port – nastav podle potřeby
PORT=7000

# Veřejná URL addonu (bez lomítka na konci). Když chybí, odvodí se z požadavku.
APP_URL=https://webshare-stremio.freeddns.org

# Indexer (resolve-ids pro anime) – interně přes Coolify síť, veřejná adresa jako záloha
INDEXER_URL=http://indexer:3003
INDEXER_FALLBACK_URL=https://indexer.ddnsfree.com

# Serverový TMDB klíč (české/slovenské názvy) – použije se, když uživatel nezadá vlastní
TMDB_API_KEY=

# Podrobný log hledání (1 = zapnuto)
DEBUG=0

# Hellspy přes český proxy (prázdné = Hellspy vypnutý, "direct" = bez proxy)
HELLSPY_PROXY=

# Klíč pro stažení archivu hledání (/admin/hledani.jsonl.gz?key=…); prázdné = vypnuto
ADMIN_KEY=

# Nahrávání archivu hledání na GitHub (fine-grained token jen s Contents: Read and write na daný repo)
GH_ARCHIVE_REPO=david325345/nimetodex-media
GH_ARCHIVE_TOKEN=
# GH_ARCHIVE_PATH=hledani
# GH_ARCHIVE_HOURS=48
# GH_ARCHIVE_HOUR=3
